<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addons>
  <!-- Repositório 6a3l -->
  <addon
    id="repository.6a3l"
    name="6a3l Repository"
    version="1.0.0"
    provider-name="6a3l">

    <extension point="xbmc.addon.repository">
      <info compressed="false">
        https://drive.google.com/uc?export=download&id=1vVRAP5oApfPkMAHbdCc3yQ3D-Tc2Le4M
      </info>
      <checksum>
        https://drive.google.com/uc?export=download&id=1I6s2HDV0KTx1hYX-sfFNhisBgaoTqCc2
      </checksum>
      <datadir zip="false">
        https://drive.google.com/uc?export=download&id=1vVRAP5oApfPkMAHbdCc3yQ3D-Tc2Le4M
      </datadir>
    </extension>

    <extension point="xbmc.addon.metadata">
      <summary>6a3l Repository</summary>
      <description>Repositório 6a3l para addons Kodi</description>
      <platform>all</platform>
    </extension>

  </addon>

  <!-- Addon de filmes -->
  <addon
    id="plugin.video.6a3l.filmes"
    name="6a3l Filmes"
    version="1.0.0"
    provider-name="6a3l">

    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
    </requires>

    <extension point="xbmc.python.pluginsource"
               library="plugin.video.6a3l.filmes/default.py">
        <provides>video</provides>
    </extension>

    <extension point="xbmc.addon.metadata">
        <summary>Filmes 6a3l</summary>
        <description>Addon de filmes do repositório 6a3l</description>
        <platform>all</platform>
    </extension>

  </addon>
</addons>
